<?xml version="1.0"?>
<configuration>
  <!--
    For a description of web.config changes see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.8" />
      </system.Web>
  -->
  <connectionStrings>
    <add name="KYCConnString" connectionString="Server=(localdb)\MSSQLLocalDB;Database=KYCDB;Integrated Security=True;" providerName="System.Data.SqlClient" />
  </connectionStrings>
  
  <system.web>
    <compilation debug="true" targetFramework="4.8"/>
    <httpRuntime targetFramework="4.8" maxRequestLength="10240" /> <!-- Enable up to 10MB upload sizes on server side safely -->
    <pages controlRenderingCompatibilityVersion="4.0"/>
  </system.web>
</configuration>